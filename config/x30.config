CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_totolink_X30=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_ca-bundle=y

CONFIG_BUILD_LOG=y

# SQM / CAKE for bufferbloat control
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_tc-tiny is not set
# CONFIG_PACKAGE_ip-tiny is not set

# cake-autorate installer/runtime prerequisites
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_fping=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-certificates=y

# Handy editor for router-side cake-autorate config edits
CONFIG_PACKAGE_nano=y

# Preserve tools already installed on the test router.
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iperf3=y
